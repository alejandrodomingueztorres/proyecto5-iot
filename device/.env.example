# Solo para probar en tu PC con `docker run --env-file .env`. Copia este archivo a .env (NO se sube al repo).
# En los dispositivos reales estas variables se definen en el dashboard de Balena.
DEVICE_ID=dev01
MQTT_USER=dev01
MQTT_PASSWORD=cambiar-esta-clave
BROKER_HOST=IP_O_DNS_DE_LA_VM_AZURE
BROKER_PORT=8883
CA_CERT_PATH=/app/ca.crt
PUBLISH_INTERVAL=5
